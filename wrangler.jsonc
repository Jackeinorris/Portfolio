{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-04-25",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "jvdiasfilms.com.br", "custom_domain": true },
    { "pattern": "www.jvdiasfilms.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Só os vídeos do mapa passam pelo Worker (trechos via R2); o resto sai direto dos arquivos estáticos.
    "run_worker_first": ["/mapa/media/videos/*"]
  },
  "r2_buckets": [
    { "binding": "MAPA_VIDEOS", "bucket_name": "mapa-videos" }
  ]
}
